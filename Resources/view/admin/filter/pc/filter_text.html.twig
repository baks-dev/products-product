<div class="d-flex gap-3 align-items-center mt-3">

    {% if
        filter.category is defined and filter.category.vars.data
        or filter.offer is defined and filter.offer.vars.data
        or filter.variation is defined and filter.variation.vars.data
        or filter.modification is defined and filter.modification.vars.data %}

        <a href="{{ path('core:refresh') }}" class="btn btn-link text-muted">
            <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" fill="currentColor"
                 class="mb-1" viewBox="0 0 16 16">
                <path d="M8 15A7 7 0 1 1 8 1a7 7 0 0 1 0 14m0 1A8 8 0 1 0 8 0a8 8 0 0 0 0 16"/>
                <path d="M4.646 4.646a.5.5 0 0 1 .708 0L8 7.293l2.646-2.647a.5.5 0 0 1 .708.708L8.707 8l2.647 2.646a.5.5 0 0 1-.708.708L8 8.707l-2.646 2.647a.5.5 0 0 1-.708-.708L7.293 8 4.646 5.354a.5.5 0 0 1 0-.708"/>
            </svg>
        </a>

    {% endif %}


    {% if filter.category is defined and filter.category.vars.data and filter.category.vars.data.options is defined %}
        <div><small class="text-muted">Категория:</small>&nbsp;
            <strong>{{ filter.category.vars.data.options }}</strong>
        </div>
    {% endif %}

    {% if filter.offer is defined and filter.offer.vars.data %}
        <div>
            <small class="text-muted small">{{ filter.offer.vars.label }}:</small>&nbsp;
            <strong>{{ filter.offer.vars.data|trans({}, filter.offer.vars.translation_domain) }}</strong>
        </div>
    {% endif %}

    {% if filter.variation is defined and filter.variation.vars.data %}
        <div>
            <small class="text-muted small">{{ filter.variation.vars.label }}:</small>&nbsp;
            <strong>{{ filter.variation.vars.data|trans({}, filter.variation.vars.translation_domain) }}</strong>
        </div>
    {% endif %}

    {% if filter.modification is defined and filter.modification.vars.data %}
        <div>
            <small class="text-muted small">{{ filter.modification.vars.label }}:</small>&nbsp;
            <strong>{{ filter.modification.vars.data|trans({}, filter.modification.vars.translation_domain) }}</strong>
        </div>
    {% endif %}

    {% if filter.property is defined %}
        {% for property in filter.property|filter(v => v.vars.data.value is not null and v.vars.data.value != 'false') %}
            <div>
                <small class="text-muted small">{{ property.vars.data.label }}:</small>&nbsp;
                <strong>{{ property.vars.data.value|trans({}, property.vars.data.domain) }}</strong>
            </div>
        {% endfor %}
    {% endif %}

</div>